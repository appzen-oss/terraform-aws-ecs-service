    {
        "name": "${name}",
        "image": "${image}",
        "memory": ${memory},
        "memoryReservation": ${memory_reservation},
        "portMappings": [],
        "environment": ${environment},
        "mountPoints": [],
        "firelensConfiguration": {
            "type": "fluentbit"
        },
        "logConfiguration": {
            "logDriver": "awslogs",
            "options": {
               "awslogs-group": "${awslogs_group}",
               "awslogs-create-group": "true",
               "awslogs-region": "${awslogs_region}",
               "awslogs-stream-prefix": "firelens"
            }
        }
        ${additional_config}
    }
